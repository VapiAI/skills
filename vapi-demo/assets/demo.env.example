# vapi-demo intake — fill this in BEFORE any building starts.
# Copy to demo.env in the project folder. NEVER commit it; add demo.env to
# .gitignore in the same step that creates it.

# --- Required ---------------------------------------------------------------

# The PRIVATE api key of the org that owns the agent. Private, not public:
# the builder uses it to pull the full assistant/squad/tool configs, to wire
# serverMessages, and to read call records + artifacts when debugging why a
# panel stays empty. Without it the builder is blind.
VAPI_API_KEY=

# The SAME value again, under the name the web-call token minter in
# server-skeleton.mjs reads. Two names exist because the squad roster loader
# reads VAPI_API_KEY and the token minter reads VAPI_PRIVATE_KEY. Set both here
# and as Railway variables, or the web-call button answers 503.
VAPI_PRIVATE_KEY=

# Exactly one of these. Squad wiring touches every member (see Default path).
ASSISTANT_ID=
SQUAD_ID=

# --- Required to demo over the phone -----------------------------------------

# The number callers dial, and its Vapi id. Shown in the dashboard header.
# If the agent has no number yet, decide BEFORE building: attach one, or use
# the web-call button instead (then fill the section below).
PHONE_NUMBER=
PHONE_NUMBER_ID=

# --- Only if the demo uses the web-call button or assistant-request ----------

VAPI_ORG_ID=
# Set after the first Railway deploy (the https://....up.railway.app origin).
PUBLIC_ORIGIN=
